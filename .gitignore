!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js & Build Artifacts
/.next/
/out/
/build
/.turbo/
.cache/

# Environment Files (protect secrets, allow .env.example)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
